---
import { useTranslations, routePath, type Locale } from "@/i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "./LanguagePicker.astro";
import DesktopButton from "./DesktopButton.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const rp = (key: Parameters<typeof routePath>[0]) => routePath(key, locale);

// N5 pide un nav dimensionado por su contenido: si la lista lo empuja más allá de
// ~720px deja de ser una píldora y es una barra con las puntas redondeadas.
// "Viewer" sale de la lista — el wordmark ya lleva a home, era navegación redundante.
const nav = [
  { label: t("nav.how_to"), href: rp("how-to") },
  { label: t("nav.compare"), href: rp("compare") },
  { label: t("nav.faq"), href: rp("faq") },
];
const path = Astro.url.pathname;
const atHome = path === rp("home");
---

<!--
  N5 · Floating pill. La envoltura es `sticky`, no `fixed`, a propósito: sigue ocupando
  su alto en el flujo, así las seis plantillas de página conservan su holgura superior
  sin repartir un padding-top nuevo por todas ellas. La píldora sigue estando despegada
  de los bordes, que es lo que define a N5. La franja transparente no captura clics
  (pointer-events), solo la píldora y el panel móvil.
-->
<header class="pointer-events-none sticky top-0 z-40 flex flex-col items-center gap-2 px-4 py-3">
  <nav
    class="pointer-events-auto flex items-center gap-1 rounded-full border border-ink-200/70 bg-white/75 py-1.5 pl-3 pr-1.5 shadow-[0_8px_24px_-12px_rgb(11_14_20/0.18)] backdrop-blur-xl backdrop-saturate-150 dark:border-ink-700/60 dark:bg-ink-900/75"
    aria-label="Primary"
  >
    <!-- Wordmark — es también el enlace a home, por eso "Viewer" no está en la lista -->
    <a
      href={rp("home")}
      aria-current={atHome ? "page" : undefined}
      class="flex shrink-0 items-center gap-2 whitespace-nowrap text-sm font-semibold tracking-tight text-ink-900 dark:text-white"
    >
      <Logo class="h-6 w-6" />
      <span class="hidden sm:inline">Online&nbsp;Mbox&nbsp;Viewer</span>
      <span class="sm:hidden">Mbox&nbsp;Viewer</span>
    </a>

    <span class="mx-1 hidden h-5 w-px shrink-0 bg-ink-200 lg:block dark:bg-ink-700" aria-hidden="true"></span>

    <div class="hidden items-center gap-0.5 lg:flex">
      {
        nav.map((item) => {
          const active = path === item.href;
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium transition-colors duration-200 ease-out",
                active
                  ? "text-brand-600 dark:text-brand-300"
                  : "text-ink-600 hover:text-ink-900 dark:text-ink-300 dark:hover:text-white",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>

    <span class="mx-1 hidden h-5 w-px shrink-0 bg-ink-200 lg:block dark:bg-ink-700" aria-hidden="true"></span>

    <div class="flex items-center gap-1">
      <LanguagePicker locale={locale} />
      <ThemeToggle locale={locale} />
      <!-- El CTA entra solo a partir de xl: entre 1024 y 1279 empujaba la píldora
           hasta rozar el ancho del viewport, que es justo lo que N5 prohíbe. -->
      <div class="hidden xl:block">
        <DesktopButton label={t("nav.desktop")} class="!px-4 !py-1.5 text-sm" />
      </div>
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-600 lg:hidden dark:text-ink-300"
        aria-label={t("common.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú móvil: hoja bajo la píldora, no una banda a ancho completo -->
  <div
    id="mobile-menu"
    class="pointer-events-auto hidden w-full max-w-sm rounded-2xl border border-ink-200/70 bg-white/95 p-2 shadow-[0_12px_32px_-16px_rgb(11_14_20/0.3)] backdrop-blur-xl lg:hidden dark:border-ink-700/60 dark:bg-ink-900/95"
  >
    <nav class="flex flex-col" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? "page" : undefined}
            class="rounded-xl px-3 py-2.5 text-base font-medium text-ink-700 hover:bg-ink-50 dark:text-ink-200 dark:hover:bg-ink-800"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-2">
      <DesktopButton label={t("nav.desktop")} class="w-full justify-center" />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", open ? "false" : "true");
  });
</script>
