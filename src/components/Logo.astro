---
/** Marca inline: sobre dentro de un cuadrado con gradiente de marca. */
interface Props {
  class?: string;
}
const { class: className = "h-7 w-7" } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} role="img" aria-label="Online Mbox Viewer">
  <defs>
    <linearGradient id="omv-logo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#635bf1"></stop>
      <stop offset="1" stop-color="#0ea5e9"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill="url(#omv-logo)"></rect>
  <path
    d="M8 11.5a1.5 1.5 0 0 1 1.5-1.5h13a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 8 20.5v-9Z"
    fill="none"
    stroke="#fff"
    stroke-width="1.7"></path>
  <path d="m9 12 7 5 7-5" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
