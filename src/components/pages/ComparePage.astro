---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import DesktopButton from "@/components/DesktopButton.astro";
import { useTranslations, routePath, type Locale } from "@/i18n/utils";
import { getCompare } from "@/data/compare";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const c = getCompare(locale);
---

<BaseLayout locale={locale} title={c.title} description={c.description}>
  <section class="container-page py-16 sm:py-20">
    <header class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        {c.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-600 dark:text-ink-300">{c.intro}</p>
    </header>

    <div class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-2xl border border-ink-100 dark:border-ink-800">
      <table class="w-full border-collapse text-left text-sm">
        <thead class="bg-ink-50 dark:bg-ink-900">
          <tr>
            <th class="px-4 py-3 font-semibold text-ink-900 dark:text-white"></th>
            <th class="px-4 py-3 font-semibold text-brand-600 dark:text-brand-300">{c.onlineLabel}</th>
            <th class="px-4 py-3 font-semibold text-ink-900 dark:text-white">{c.desktopLabel}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.rows.map((r) => (
              <tr class="border-t border-ink-100 dark:border-ink-800">
                <th class="px-4 py-3 text-left font-medium text-ink-700 dark:text-ink-200">{r.feature}</th>
                <td class="px-4 py-3 text-ink-600 dark:text-ink-300">{r.online}</td>
                <td class="px-4 py-3 text-ink-600 dark:text-ink-300">{r.desktop}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-brand-200 bg-brand-50 p-6 dark:border-brand-800 dark:bg-brand-900/30">
      <p class="text-ink-700 dark:text-ink-200">{c.closing}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <DesktopButton label={t("cta.get_desktop")} variant="brand" />
        <a
          href={routePath("home", locale)}
          class="btn-ghost"
        >
          <Icon name="upload" class="h-4 w-4" />
          {t("cta.open_viewer")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
