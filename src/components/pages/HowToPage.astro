---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import DesktopButton from "@/components/DesktopButton.astro";
import { useTranslations, routePath, type Locale } from "@/i18n/utils";
import { getHowTo } from "@/data/howto";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const g = getHowTo(locale);

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: g.title,
  description: g.description,
  step: g.steps.map((s, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: s.title,
    text: s.body,
  })),
};
---

<BaseLayout locale={locale} title={g.title} description={g.description} schema={schema}>
  <article class="container-prose py-16 sm:py-20">
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        {g.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-600 dark:text-ink-300">{g.intro}</p>
      <div class="mt-6">
        <a href={routePath("home", locale)} class="btn-brand">
          <Icon name="upload" class="h-4 w-4" />
          {t("cta.open_viewer")}
        </a>
      </div>
    </header>

    <h2 class="mt-14 text-2xl font-bold tracking-tight text-ink-900 dark:text-white">{g.stepsHeading}</h2>
    <ol class="mt-6 space-y-5">
      {
        g.steps.map((s, i) => (
          <li class="flex gap-4">
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-bold text-brand-600 dark:bg-brand-900/40 dark:text-brand-300">
              {i + 1}
            </span>
            <div>
              <h3 class="font-semibold text-ink-900 dark:text-white">{s.title}</h3>
              <p class="mt-1 leading-relaxed text-ink-600 dark:text-ink-300">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <h2 class="mt-14 text-2xl font-bold tracking-tight text-ink-900 dark:text-white">{g.exportHeading}</h2>
    <p class="mt-3 text-ink-600 dark:text-ink-300">{g.exportIntro}</p>
    <div class="mt-6 space-y-4">
      {
        g.exporters.map((e) => (
          <div class="card">
            <h3 class="font-semibold text-ink-900 dark:text-white">{e.name}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{e.how}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-14 text-2xl font-bold tracking-tight text-ink-900 dark:text-white">{g.whatHeading}</h2>
    <ul class="mt-5 space-y-2">
      {
        g.what.map((w) => (
          <li class="flex items-start gap-2 text-ink-600 dark:text-ink-300">
            <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-500" />
            <span>{w}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 rounded-2xl border border-ink-800 bg-ink-950 p-8 text-center">
      <h2 class="text-xl font-bold text-white">{g.desktopHeading}</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-300">{g.desktopBody}</p>
      <div class="mt-5 flex justify-center">
        <DesktopButton label={t("cta.appstore_short")} variant="brand" />
      </div>
    </div>
  </article>
</BaseLayout>
