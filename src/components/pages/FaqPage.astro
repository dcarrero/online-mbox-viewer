---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DesktopButton from "@/components/DesktopButton.astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import { getFaq } from "@/data/faq";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const f = getFaq(locale);

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: f.items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<BaseLayout locale={locale} title={f.title} description={f.description} schema={schema}>
  <section class="container-prose py-16 sm:py-20">
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        {f.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-600 dark:text-ink-300">{f.intro}</p>
    </header>

    <dl class="mt-12 space-y-8">
      {
        f.items.map((i) => (
          <div class="border-b border-ink-100 pb-8 dark:border-ink-800" data-reveal>
            <dt class="text-lg font-semibold text-ink-900 dark:text-white">{i.q}</dt>
            <dd class="mt-2 leading-relaxed text-ink-600 dark:text-ink-300">{i.a}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-12 flex flex-wrap items-center gap-3">
      <DesktopButton label={t("cta.get_desktop")} variant="brand" />
    </div>
  </section>
</BaseLayout>
