---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import { getLegal } from "@/data/legal";

interface Props {
  locale: Locale;
  doc: "privacy" | "terms";
}
const { locale, doc } = Astro.props;
const t = useTranslations(locale);
const d = getLegal(locale)[doc];
---

<BaseLayout locale={locale} title={d.title} description={d.description}>
  <article class="container-prose py-16 sm:py-20">
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        {d.title}
      </h1>
      <p class="mt-3 text-sm text-ink-500 dark:text-ink-400">{t("common.updated")}: {d.updated}</p>
      <p class="mt-6 text-lg leading-relaxed text-ink-600 dark:text-ink-300">{d.intro}</p>
    </header>

    <div class="prose mt-10">
      {
        d.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
