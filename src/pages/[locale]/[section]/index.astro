---
import HowToPage from "@/components/pages/HowToPage.astro";
import FaqPage from "@/components/pages/FaqPage.astro";
import ComparePage from "@/components/pages/ComparePage.astro";
import LegalPage from "@/components/pages/LegalPage.astro";
import { LOCALES, DEFAULT_LOCALE, type Locale } from "@/i18n/config";
import { SECTION_ROUTES, getSlug, type RouteKey } from "@/i18n/routes";

/**
 * Router de sección por idioma. Genera, para cada idioma no predeterminado y
 * cada sección, su slug localizado (p. ej. /es/preguntas/, /de/vergleich/).
 */
export function getStaticPaths() {
  const paths: { params: { locale: string; section: string }; props: { locale: Locale; key: RouteKey } }[] = [];
  for (const locale of LOCALES) {
    if (locale === DEFAULT_LOCALE) continue;
    for (const key of SECTION_ROUTES) {
      paths.push({
        params: { locale, section: getSlug(key, locale) },
        props: { locale, key },
      });
    }
  }
  return paths;
}

interface Props {
  locale: Locale;
  key: RouteKey;
}
const { locale, key } = Astro.props;
---

{key === "how-to" && <HowToPage locale={locale} />}
{key === "faq" && <FaqPage locale={locale} />}
{key === "compare" && <ComparePage locale={locale} />}
{key === "privacy" && <LegalPage locale={locale} doc="privacy" />}
{key === "terms" && <LegalPage locale={locale} doc="terms" />}
